# Backend API Configuration
# Copy this file to .env.local and update with your backend URL

# Your external backend API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Or use your production backend
# NEXT_PUBLIC_API_BASE_URL=https://renthubbackend.onrender.com/api

# Google Maps API Key (if using maps feature)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
